# Django Settings
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=your-secret-key-here

# DEBUG defaults to False when unset, so production fails closed.
DEBUG=True

# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Production only (ignored while DEBUG=True)
# CSRF_TRUSTED_ORIGINS=https://example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Site identity -----------------------------------------------------
# Rendered in the hero, contact section, footer, structured data and the
# generated link-preview image. All optional; the defaults are in settings.py.
# SITE_OWNER=Anand N
# SITE_ROLE=AI Developer
# SITE_TAGLINE=Python · Machine Learning · Computer Vision
# SITE_DESCRIPTION=Computer Science Engineering graduate building AI and...
# SITE_EMAIL=you@example.com
# SITE_PHONE=+91 7306922640
# SITE_GITHUB_URL=https://github.com/your-handle
# SITE_LINKEDIN_URL=https://linkedin.com/in/your-handle
# SITE_LOCATION=Trivandrum, Kerala, India
# SITE_CURRENT=Artificial Intelligence Intern, Yangtso Four Labs
# SITE_FOCUS=AI, machine learning and Python development

# Availability pill in the hero. Set to an empty value to hide it — a stale
# "open to work" badge is worse than no badge.
# SITE_AVAILABILITY=Open to opportunities

# Absolute site URL. Required in production so canonical tags and the
# og:image resolve to real, crawlable addresses.
# SITE_URL=https://your-domain.com

# Paths inside static/. Each appears only once the file actually exists.
# RESUME_STATIC_PATH must match the real filename on disk, or the download
# button silently stays hidden. RESUME_DOWNLOAD_NAME is what the visitor's
# browser saves it as.
# Variants on disk: ..._ATS_Python_AI_ML (served — matches the AI positioning)
# and Anand_SE_FSD_Dev_Final (software engineering / full stack). Switch this
# if the site's positioning moves.
# RESUME_STATIC_PATH=files/Resume_Anand_Final_ATS_Python_AI_ML.pdf
# RESUME_DOWNLOAD_NAME=Anand_N_Resume.pdf
# OG_IMAGE_STATIC_PATH=img/og-image.png

# Email Settings (for future use)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=your-email@example.com
